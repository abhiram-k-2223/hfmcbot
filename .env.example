# ---- mode ----
# paper | live (live is NOT implemented until M4; binary refuses to start in live)
HFM_MODE=paper

# ---- capital ----
HFM_EQUITY_USD=50000

# ---- entry gate (BUILD_PROMPT.md section 4) ----
HFM_ENTRY_MAX_AGE_SECS=600
HFM_MIN_LIQUIDITY_USD=50000
HFM_MAX_DEV_HOLD_PCT=10
HFM_MAX_SLIPPAGE_PCT=10

# ---- funnel entry ----
HFM_FUNNEL_SLICES=3
HFM_FUNNEL_WINDOW_SECS=5

# ---- position sizing (risk-first) ----
HFM_RISK_PER_TRADE_PCT=2.5
HFM_MAX_SINGLE_POS_USD=5000
HFM_MAX_OPEN_POSITIONS=12

# ---- exit: flip mode (default for the spray) ----
HFM_TAKE_PROFIT_PCT=120
HFM_STOP_LOSS_PCT=30
HFM_MAX_HOLD_SECS=21600

# ---- exit: conviction / trail mode ----
HFM_CONVICTION_MIN_PCT=300
HFM_TRAIL_PCT=25
HFM_CONVICTION_MAX_HOLD_DAYS=15

# ---- risk & controls (NON-NEGOTIABLE) ----
HFM_DAILY_LOSS_LIMIT_PCT=10
HFM_MAX_TRADES_PER_MIN=6
HFM_KILL_SWITCH=false

# ---- paper execution simulation (depth-aware slippage) ----
# fill slippage = BASE + IMPACT_COEFF * (notional/liquidity*100), capped at MAX.
# A $1.25K slice into an $8K bonding-curve pool costs ~14.5%; into $1M ~2.1%.
HFM_PAPER_SLIPPAGE_PCT=2
HFM_PAPER_IMPACT_COEFF=1
HFM_PAPER_MAX_SLIPPAGE_PCT=50
HFM_FEE_BPS=100

# ---- operator keys (M0; paper runs without, live requires) ----
# Any Solana export format: base58 64-byte key, base58 32-byte seed, or JSON array.
# NEVER commit a real key — the secret is never logged, only the pubkey.
HFM_SECRET_KEY=
# SECRET_KEY=  # fallback alias

# ---- observability (M0) ----
# Prometheus-text /metrics + /healthz bind address, heartbeat interval.
HFM_METRICS_ADDR=127.0.0.1:9898
HFM_HEARTBEAT_SECS=60

# ---- persistence / observability ----
HFM_AUDIT_LOG_PATH=data/audit.jsonl
HFM_REPLAY_EVENTS_PATH=

# ---- upstreams (M1+; unused in paper mode) ----
HFM_RPC_URL=https://api.mainnet-beta.solana.com
HFM_WS_URL=wss://api.mainnet-beta.solana.com
HFM_JITO_URL=https://mainnet.block-engine.jito.wtf
HFM_JITO_TIP_LAMPORTS=1000000
