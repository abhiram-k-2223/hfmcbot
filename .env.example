# hfmcbot example env. A BLANK value means "unset" (the compiled default
# applies) — exactly like deleting the line. Garbage values fail loudly.
# ---- mode ----
# paper | live. Live boots the M4 executor: operator key + RPC self-check +
# HFM_SOL_USD are required; replay files are refused in live mode.
HFM_MODE=paper

# ---- capital ----
HFM_EQUITY_USD=50000

# ---- entry gate (BUILD_PROMPT.md section 4) ----
HFM_ENTRY_MAX_AGE_SECS=600
HFM_MIN_LIQUIDITY_USD=50000
HFM_MAX_DEV_HOLD_PCT=10
HFM_MAX_SLIPPAGE_PCT=10

# ---- funnel entry ----
HFM_FUNNEL_SLICES=3
HFM_FUNNEL_WINDOW_SECS=5

# ---- position sizing (risk-first) ----
HFM_RISK_PER_TRADE_PCT=2.5
HFM_MAX_SINGLE_POS_USD=5000
HFM_MAX_OPEN_POSITIONS=12

# ---- exit: flip mode (default for the spray) ----
HFM_TAKE_PROFIT_PCT=120
HFM_STOP_LOSS_PCT=30
HFM_MAX_HOLD_SECS=21600
# Failed sell attempts before a position is marked stuck/unsellable (M3.5:
# funds stay deployed, sweep skips it, fresh ticks still retry).
HFM_MAX_EXIT_ATTEMPTS=5

# ---- exit: conviction / trail mode ----
HFM_CONVICTION_MIN_PCT=300
HFM_TRAIL_PCT=25
HFM_CONVICTION_MAX_HOLD_DAYS=15

# ---- risk & controls (NON-NEGOTIABLE) ----
HFM_DAILY_LOSS_LIMIT_PCT=10
HFM_MAX_TRADES_PER_MIN=6
HFM_KILL_SWITCH=false

# ---- paper execution simulation (depth-aware slippage) ----
# fill slippage = BASE + IMPACT_COEFF * (notional/liquidity*100), capped at MAX.
# A $1.25K slice into an $8K bonding-curve pool costs ~14.5%; into $1M ~2.1%.
HFM_PAPER_SLIPPAGE_PCT=2
HFM_PAPER_IMPACT_COEFF=1
HFM_PAPER_MAX_SLIPPAGE_PCT=50
HFM_FEE_BPS=100

# ---- operator keys (M0; paper runs without, live requires) ----
# Any Solana export format: base58 64-byte key, base58 32-byte seed, or JSON array.
# NEVER commit a real key — the secret is never logged, only the pubkey.
HFM_SECRET_KEY=
# SECRET_KEY=  # fallback alias

# ---- observability (M0) ----
# Prometheus-text /metrics + /healthz bind address, heartbeat interval.
HFM_METRICS_ADDR=127.0.0.1:9898
HFM_HEARTBEAT_SECS=60

# ---- persistence / observability ----
HFM_AUDIT_LOG_PATH=data/audit.jsonl
HFM_REPLAY_EVENTS_PATH=
# M6 crash recovery: atomic book snapshots (positions, ledger, breaker state)
# written periodically + on shutdown/disconnect; live boot resumes from the
# snapshot and REFUSES to boot on a corrupt one (paper starts flat instead).
HFM_STATE_PATH=
HFM_STATE_EVERY_SECS=60

# ---- alerting (M6) ----
# Webhook URL for JSON alert POSTs (kill, breaker trip, stuck, unknown exit,
# snapshot failure). Empty = log-only (alerts still ERROR-log, rate-limited).
HFM_ALERT_WEBHOOK_URL=
# Minimum seconds between repeat alerts of the same kind.
HFM_ALERT_MIN_SECS=300

# ---- upstreams (M1+; unused in paper mode) ----
HFM_RPC_URL=https://api.mainnet-beta.solana.com
# M6 failover: ordered RPC fallbacks, tried after the primary on transport
# errors only (sticky-success: the last known-good endpoint stays preferred).
# Comma-separated, blank = primary only.
HFM_RPC_FALLBACK_URLS=
HFM_WS_URL=wss://api.mainnet-beta.solana.com
HFM_JITO_URL=https://mainnet.block-engine.jito.wtf
# Base Jito tip (lamports). Each urgency tier defaults to it unless priced.
HFM_JITO_TIP_LAMPORTS=1000000
# M6 tip tiers: flip stops outbid conviction trails outbid entries. Each tier
# is expressed TWICE: as the swap's prioritizationFeeLamports AND as a
# standalone SystemProgram tip-transfer tx bundled swap-first/tip-second.
# Each defaults to HFM_JITO_TIP_LAMPORTS when commented out — uncomment to price.
# HFM_JITO_TIP_ENTRY_LAMPORTS=1000000
# HFM_JITO_TIP_FLIP_LAMPORTS=2000000
# HFM_JITO_TIP_CONVICTION_LAMPORTS=1500000
# Tip destination accounts (REQUIRED before real sends — orders are fail-closed
# without one): Jito's published tip accounts, comma-separated, round-robined
# per bundle. Blank = unset (paper + simulate-only need nothing).
# HFM_JITO_TIP_ACCOUNT=

# ---- live execution (M4 pipeline: quote -> preflight -> swap -> sign -> bundle -> reconcile) ----
# Jupiter Swap API v1 (keyless v6 is sunset — v1 needs an x-api-key for real quota).
HFM_JUPITER_URL=https://api.jup.ag/swap/v1
HFM_JUPITER_API_KEY=
# Sustained quote rate; doubles as the token-bucket burst (spec §6 governor).
HFM_JUPITER_QPS=1
# SIMULATE_ONLY=true (default): swaps are assembled + SIGNED but never submitted —
# fills are reported from quote math and loudly logged as simulated. Set false to send.
HFM_SIMULATE_ONLY=true
# Seconds to poll Jito for bundle landing before declaring order state unknown.
HFM_BUNDLE_TIMEOUT_SECS=60
# Blockhash manager: seconds a fetched blockhash is reused across bundles
# before refetching (bounds staleness without a per-bundle RPC round trip).
HFM_BLOCKHASH_TTL_SECS=30
# Post-landing reconciliation dust (tokens): balance mismatch within this of
# the claimed fill passes; beyond it the fill is UNKNOWN (Transport) and the
# operator is paged. Covers route dust, not real divergence.
HFM_RECONCILE_DUST_TOKENS=0.000001

# ---- Postgres audit mirror (roadmap, needs --features pg) ----
# DSN for the queryable audit copy (JSONL stays the primary trail). Blank =
# off. Live boot REFUSES on a dead mirror; paper warns and continues file-only.
# Needs a local socket / SSH tunnel / TLS proxy — the driver uses NoTls.
# HFM_PG_DSN=postgres://bot@localhost/hfmcbot

# Live feed (M1, read-only recording). Empty = unconfigured; the feed refuses
# to connect until HFM_GEYSER_URL is set. Start on a free/cheap
# Yellowstone-compatible tier for development; step up only for the soak.
HFM_GEYSER_URL=
HFM_GEYSER_TOKEN=
# processed | confirmed | finalized (recorder tags commitment per event)
HFM_FEED_COMMITMENT=processed

# Soak recorder (free pumpportal WS, D13 — `cargo run --bin record`).
# Keyless; no HFM_WS_URL clash (that one is the Solana pubsub endpoint).
HFM_SOAK_WS_URL=wss://pumpportal.fun/api/data
HFM_RAW_PATH=data/ws_raw.jsonl
HFM_EVENTS_PATH=data/ws_events.jsonl
# Optional operator-supplied SOL/USD rate enabling enrichment (absent =
# raw-only archive mode; the rate used is logged at startup). REQUIRED for
# HFM_MODE=live (buy path converts USD to lamports; live boot refuses without it).
HFM_SOL_USD=
